{
    "name": "zakharov-andrew/yii2-user",
    "description": "Yii2 User",
    "type": "yii2-extension",
    "keywords": ["yii2", "extension", "module", "access", "permissions", "rights", "roles", "users", "admin", "yii 2", "profile"],
    "license": "MIT",
    "authors": [
        {
            "name": "Andrew Zakharov",
            "homepage": "https://github.com/ZakharovAndrew",
            "role": "Developer"
        }
    ],
    "scripts": {
        "phpstan": "vendor/bin/phpstan"
    },
    "require": {
        "php": ">=7.2",
        "firebase/php-jwt" : "*",
        "yiisoft/yii2": "*"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "ZakharovAndrew\\user\\": "src"
        }
    },
    "fxp-asset": {
        "enabled": false
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "mspirkov/yii2-phpstan": "^0.18.0"
    }
}
